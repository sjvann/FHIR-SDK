<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fhir.Path.R4</RootNamespace>
    <AssemblyName>Fhir.Path.R4</AssemblyName>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Fhir.Path.R4</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Description>R4 FHIRPath 門面（一般請透過 Fhir.Sdk.R4 引用）。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fhir.Path\Fhir.Path.csproj" />
    <ProjectReference Include="..\Fhir.TypeFramework.Interop\Fhir.TypeFramework.Interop.csproj" />
    <ProjectReference Include="..\Fhir.ResourceCreator\generated\Fhir.Resources.R4\Fhir.Resources.R4.csproj" />
  </ItemGroup>

</Project>
