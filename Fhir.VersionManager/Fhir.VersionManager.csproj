<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fhir.VersionManager</RootNamespace>
    <AssemblyName>Fhir.VersionManager</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Fhir.VersionManager</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>FHIR SDK Team</Authors>
    <Description>FHIR 線別偵測／宣告與 CapabilityStatement 跨線別窄化（多線別 DX）。</Description>
    <PackageTags>FHIR;HL7;SDK;VersionManager</PackageTags>
    <RepositoryUrl>https://github.com/sjvann/FHIR-SDK</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fhir.TypeFramework\Fhir.TypeFramework.csproj" />
    <ProjectReference Include="..\Fhir.ResourceCreator\generated\Fhir.Resources.R4\Fhir.Resources.R4.csproj" />
    <ProjectReference Include="..\Fhir.ResourceCreator\generated\Fhir.Resources.R4B\Fhir.Resources.R4B.csproj" />
    <ProjectReference Include="..\Fhir.ResourceCreator\generated\Fhir.Resources.R5\Fhir.Resources.R5.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
