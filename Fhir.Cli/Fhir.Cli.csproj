<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Fhir.Cli</RootNamespace>
    <AssemblyName>fhir</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fhir</ToolCommandName>
    <PackageId>Fhir.Cli</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>FHIR SDK Team</Authors>
    <Description>Official FHIR SDK CLI: parse, serialize, path, validate, snapshot, package, metadata.</Description>
    <PackageTags>FHIR;HL7;CLI</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fhir.TypeFramework\Fhir.TypeFramework.csproj" />
    <ProjectReference Include="..\Fhir.Path\Fhir.Path.csproj" />
    <ProjectReference Include="..\Fhir.Validation\Fhir.Validation.csproj" />
    <ProjectReference Include="..\Fhir.Artifacts\Fhir.Artifacts.csproj" />
    <ProjectReference Include="..\Fhir.VersionManager\Fhir.VersionManager.csproj" />
    <ProjectReference Include="..\Fhir.Packages.Registry\Fhir.Packages.Registry.csproj" />
    <ProjectReference Include="..\Fhir.Sdk.R4\Fhir.Sdk.R4.csproj" />
    <ProjectReference Include="..\Fhir.Sdk.R4B\Fhir.Sdk.R4B.csproj" />
    <ProjectReference Include="..\Fhir.Sdk.R5\Fhir.Sdk.R5.csproj" />
  </ItemGroup>

</Project>
